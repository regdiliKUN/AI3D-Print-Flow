# 本地运行产物
logs/*
workspace/input/*
workspace/glb/*
workspace/stl/*
workspace/reports/*
workflows/*.json

# 目录占位文件要保留，否则 clone 后目录不存在
!logs/.gitkeep
!workspace/input/.gitkeep
!workspace/glb/.gitkeep
!workspace/stl/.gitkeep
!workspace/reports/.gitkeep
!workflows/.gitkeep

# 本地个人配置（含本机路径，不随仓库分发）
config/config.json
config/config.json.*

# 构建产物：由 scripts/build-launcher.ps1 生成
AI3D-Print-Flow.exe
launcher/bin/
launcher/obj/

# 内置 Node 运行时：约 90 MB 二进制，由打包流程放置，
# 不进仓库（GitHub 单文件上限 100 MB，且会让 clone 变得很慢）
runtime/

# 依赖与编辑器
node_modules/
.vscode/
*.log
